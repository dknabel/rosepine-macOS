#!/usr/bin/env bash
# rosepine-switch [auto|tick|main|dawn|location <lat> <lon>]
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
root="$(cd "$(dirname "$src")/.." && pwd)"

. "$root/lib/render.sh"
. "$root/lib/solar.sh"

state="${ROSEPINE_STATE_DIR:-$HOME/.local/state/rose-pine}"
usage() { echo "usage: rosepine-switch [auto|tick|main|dawn|location <lat> <lon>]" >&2; exit 2; }

mode="${1:-auto}"
mkdir -p "$state"
case "$mode" in
  auto) mode="$(auto_mode)" ;;
  tick)
    mode="$(auto_mode)"
    if [ "$mode" = "$(cat "$state/mode" 2>/dev/null)" ] && [ -s "$state/colors.sh" ] && [ -s "$state/starship.toml" ] && [ -s "$state/tmux.conf" ]; then
      exit 0
    fi ;;
  main|dawn) ;;
  location)
    [ $# -eq 3 ] || usage
    solar_times "$2" "$3" 172 0 >/dev/null || { echo "invalid or polar location: $2 $3" >&2; exit 2; }
    mkdir -p "$HOME/.config/rose-pine"
    printf '%s %s\n' "$2" "$3" > "${ROSEPINE_LOCATION_FILE:-$HOME/.config/rose-pine/location}"
    exit 0 ;;
  *) usage ;;
esac

. "$root/palettes/$mode.sh"

# Starship base (override with ROSEPINE_STARSHIP_BASE, mainly for tests).
base="${ROSEPINE_STARSHIP_BASE:-$root/../stow/starship/.config/starship/base.toml}"
if [ ! -f "$base" ]; then
  echo "warning: starship base not found: $base (rendering palette only)" >&2
  base=/dev/null
fi

atomic() { # atomic <renderer> <file> [extra args]
  local fn="$1" name="$2"; shift 2
  local tmp="$state/.$name.$$"
  "$fn" "$tmp" "$@"
  mv -f "$tmp" "$state/$name"
}
atomic render_colors_sh colors.sh
atomic render_tmux tmux.conf
atomic render_starship starship.toml "$base"
printf '%s\n' "$mode" > "$state/.mode.$$" && mv -f "$state/.mode.$$" "$state/mode"
[ "${ROSEPINE_DRY_RUN:-}" = 1 ] && exit 0

# Reloads: best effort, never affect exit status.
if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
  tmux source-file "$state/tmux.conf" >/dev/null 2>&1 || echo "warning: tmux reload failed" >&2
fi
if command -v borders >/dev/null 2>&1 && pgrep -x borders >/dev/null 2>&1; then
  borders "active_color=0xff$RP_IRIS" "inactive_color=0xff$RP_MUTED" >/dev/null 2>&1 || echo "warning: borders reload failed" >&2
fi
if command -v sketchybar >/dev/null 2>&1 && pgrep -x sketchybar >/dev/null 2>&1; then
  sketchybar --reload >/dev/null 2>&1 || echo "warning: sketchybar reload failed" >&2
fi

# Appearance flip last, backgrounded with a watchdog so a hanging Automation
# prompt can never block the reloads above. Never affects exit status.
dark=true; [ "$mode" = dawn ] && dark=false
osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark" \
  >/dev/null 2>&1 &
os_pid=$!
(
  sleep "${ROSEPINE_OSASCRIPT_TIMEOUT:-10}"
  kill "$os_pid" 2>/dev/null
) >/dev/null 2>&1 &
wd_pid=$!
wait "$os_pid" 2>/dev/null || echo "warning: could not set system appearance" >&2
kill "$wd_pid" 2>/dev/null || true
exit 0
