#!/usr/bin/env bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
# SketchyBar config. Re-read on every `sketchybar --reload`, so colors.sh
# (rendered by rosepine-switch) is sourced fresh each time.
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
COLORS="$HOME/.local/state/rose-pine/colors.sh"

# shellcheck disable=SC1090
if ! . "$COLORS" 2>/dev/null; then
  echo "sketchybarrc: $COLORS not found; using built-in Rose Pine main palette" >&2
  # Fallback block: keep identical to theme/palettes/main.sh (as 0xffRRGGBB).
  RP_BASE=0xff191724; RP_SURFACE=0xff1f1d2e; RP_OVERLAY=0xff26233a
  RP_MUTED=0xff6e6a86; RP_SUBTLE=0xff908caa; RP_TEXT=0xffe0def4
  RP_LOVE=0xffeb6f92; RP_GOLD=0xfff6c177; RP_ROSE=0xffebbcba
  RP_PINE=0xff31748f; RP_FOAM=0xff9ccfd8; RP_IRIS=0xffc4a7e7
  export RP_BASE RP_SURFACE RP_OVERLAY RP_MUTED RP_SUBTLE RP_TEXT \
    RP_LOVE RP_GOLD RP_ROSE RP_PINE RP_FOAM RP_IRIS
fi

# Record the mode this load rendered; plugins/theme.sh reloads when it drifts.
cat "$HOME/.local/state/rose-pine/mode" > "$HOME/.local/state/rose-pine/bar.mode" 2>/dev/null || true

FONT="Hack Nerd Font"
APP_FONT="sketchybar-app-font"

# Bar geometry follows the AeroSpace gaps so windows and bar share one rhythm: the
# bar's side margin is gaps.outer.left, and its bottom edge sits gaps.inner.vertical
# above the windows (the notch reserves NOTCH px; the bar starts at BAR_Y).
AERO_CFG="${AEROSPACE_CONFIG:-$HOME/.config/aerospace/aerospace.toml}"
aero_gap() { # aero_gap <key> <fallback>: read "<key> = N" from [gaps] (dotted keys like outer.left)
  local v
  v="$(awk -v k="$1" '/^\[/ { in_gaps = ($0 == "[gaps]"); next } in_gaps && $1 == k { print $3; exit }' "$AERO_CFG" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) echo "$2" ;; *) echo "$v" ;; esac
}
NOTCH=32; BAR_Y=6
MARGIN="$(aero_gap outer.left 10)"
TOP="$(aero_gap outer.top 20)"
INNER="$(aero_gap inner.vertical 10)"
BAR_H=$((NOTCH + TOP - INNER - BAR_Y))
[ "$BAR_H" -ge 20 ] || BAR_H=36

sketchybar --bar position=top height="$BAR_H" y_offset="$BAR_Y" margin="$MARGIN" corner_radius=12 \
  padding_left=10 padding_right=10 color="$RP_SURFACE" border_width=2 \
  border_color="$RP_OVERLAY" blur_radius=20

sketchybar --default \
  icon.font="$FONT:Regular:14.0" label.font="$FONT:Regular:14.0" \
  icon.color="$RP_TEXT" label.color="$RP_TEXT" \
  padding_left=5 padding_right=5 icon.padding_left=4 icon.padding_right=4 \
  label.padding_left=4 label.padding_right=4

sketchybar --add event aerospace_workspace_change

# Explicit order matters: left items read in add order (workspaces, front_app,
# media); the first right-side item added sits at the screen
# edge, so the right side reads (edge inward) clock, battery, wifi, volume.
for name in workspaces front_app media clock battery wifi volume github theme cheatsheet; do
  [ -f "$CONFIG_DIR/items/$name.sh" ] && . "$CONFIG_DIR/items/$name.sh"
done

sketchybar --update
