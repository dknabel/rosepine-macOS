# Rose Pine prompt: starship config is generated by rosepine-switch.
export STARSHIP_CONFIG="$HOME/.local/state/rose-pine/starship.toml"

if [[ ! -f "$STARSHIP_CONFIG" ]] && (( $+commands[rosepine-switch] )); then
  rosepine-switch auto
fi

if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi
